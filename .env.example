GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-live-preview
CODEX_API_TOKEN=
CODEX_DEFAULT_WORKDIR=/Users/karansaini/Projects/codex-voice-agent
CODEX_APPROVAL_MODE=auto-review
CODEX_SANDBOX_MODE=workspace-write
MAX_AUDIO_BYTES=2000000
PYTHONDONTWRITEBYTECODE=1

# Langfuse tracing (optional). Leave keys blank to disable tracing entirely.
# Keys: Langfuse UI -> Settings -> API Keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com  # EU cloud. US: https://us.cloud.langfuse.com
# On/off switch. Unset = auto (on when keys are present). Set to false to force
# off even with keys, or true to require keys (warns if missing).
LANGFUSE_TRACING_ENABLED=
